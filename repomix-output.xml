  margin-bottom: 32px;
}

.companiesGrid {
  display: flex;
  align-items: center;
  justify-content: space-between; /* Distribuye uniformemente de lado a lado */
  gap: 16px;
  flex-wrap: wrap; /* Si la pantalla es chica, se bajan con elegancia */
  width: 100%;
}

.companyPlaceholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
  flex: 1;                     /* Hace que todas las tarjetas midan exactamente lo mismo */
  min-width: 140px;            /* Evita que se colapsen en pantallas chicas */
  height: 80px;
  background: rgba(255, 255, 255, 0.03); /* El estilo que ya tenías */
  border-radius: 8px;
  height: 64px; /* O el alto que tengan tus tarjetas actuales */
}
.companyLogoImg {
  width: 100%;                /* Obliga a la imagen a ensancharse al contenedor */
  height: 100%;               /* Obliga a la imagen a estirarse a lo alto */
  object-fit: contain;        /* Mantiene la proporción perfecta del logo sin deformarlo */
  
  opacity: 0.65;              /* Tono marca de agua elegante */
  filter: grayscale(100%);    /* 🌟 TRUCO PRO: Los hace a todos grises/blancos homogéneos 
                                 para que los logos de colores no peleen con tu diseño azul */
  transition: all 0.25s ease;
}

/* Efecto elegante: cuando el alumno pasa el mouse, el logo se ilumina */
.companyPlaceholder:hover .companyLogoImg {
  opacity: 1;
  filter: grayscale(0%);      /* Recupera su color original (Oracle rojo, BBVA azul, etc.) */
}
.footer {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 20px 24px;
  background: rgba(6, 13, 31, 0.6);
  border-top: 1px solid rgba(255,255,255,0.07);
}

.footerLink {
  font-size: 13px;
  color: rgba(255,255,255,0.45);
  text-decoration: none;
  transition: color 0.2s;
  font-family: var(--font-body, 'DM Sans', sans-serif);
}

.footerLink:hover { color: rgba(255,255,255,0.8); }

/* ── Responsive Design ── */
@media (max-width: 768px) {
  .toolbar {
    padding: 8px 16px;
  }

  .toolbarGreeting {
    font-size: 12px; /* Ajuste sutil para pantallas pequeñas */
  }

  .section {
    padding: 20px 16px; /* Menos espacio lateral en móvil */
  }

  .companiesSection {
    padding: 32px 16px;
  }

  .companiesTitle {
    text-align: center;
    margin-bottom: 24px;
  }

  .companiesGrid {
    grid-template-columns: repeat(2, 1fr); /* 2 columnas en móvil */
    gap: 12px;
  }

  .footer {
    align-items: center;
    text-align: center;
    padding: 24px 16px;
  }
}

/* Ajuste adicional para pantallas muy pequeñas */
@media (max-width: 480px) {
  .companiesGrid {
    grid-template-columns: 1fr; /* 1 columna en teléfonos pequeños */
  }
}
