<file path="app/src/pages/LoginPage.css">
.login-page {
  min-height: 100vh;
}

.login-main {
  flex: 1;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60px 80px;
  gap: 40px;
}

.login-hero {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 500px;
  animation: fadeInUp 0.6s ease both;
}

.login-title {
  font-family: var(--font-display);
  font-size: clamp(42px, 6vw, 72px);
  font-weight: 800;
  color: var(--text-white);
  line-height: 1.05;
}

.login-subtitle {
  font-family: var(--font-display);
  font-size: clamp(16px, 2vw, 20px);
  font-weight: 600;
  color: var(--text-white);
  line-height: 1.5;
}

.login-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 700;
  color: var(--text-white);
}

.login-badge span {
  display: flex;
  flex-direction: column;
  font-size: 10px;
  line-height: 1;
  letter-spacing: 0.05em;
  color: var(--text-muted);
}

/* Card */
.login-card {
  background: rgba(255, 255, 255, 0.04);
  padding: 40px 36px;
  width: 100%;
  max-width: 400px;
  flex-shrink: 0;
  animation: slideInRight 0.6s ease both;
  animation-delay: 0.15s;
  backdrop-filter: blur(10px);
}

.card-title {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 6px;
}

.card-subtitle {
  font-size: 13px;
  color: var(--text-muted);
  margin-bottom: 28px;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.field-label {
  font-size: 13px;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 6px;
}

.info-btn {
  background: none;
  border: none;
  color: var(--text-subtle);
  cursor: pointer;
  font-size: 14px;
  padding: 0;
  line-height: 1;
}

.input-wrap {
  position: relative;
}

.toggle-pass {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  cursor: pointer;
  font-size: 14px;
  padding: 0;
}

.login-input {
  width: 100%;
  padding: 14px 18px;
  background: rgba(255, 255, 255, 0.08);
  border: 1.5px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-md);
  color: var(--text-white);
  font-family: var(--font-body);
  font-size: 15px;
  outline: none;
  transition: border-color 0.25s, background 0.25s;
}

.login-input::placeholder {
  color: var(--text-subtle);
}

.login-input:focus {
  border-color: rgba(201, 168, 76, 0.5);
  background: rgba(255, 255, 255, 0.11);
}

.forgot-link {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
  text-decoration: underline;
  cursor: pointer;
  margin-top: -4px;
}

.login-btn {
  margin-top: 8px;
  padding: 14px 28px;
  background: var(--btn-primary);
  border: 1.5px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-xl);
  color: var(--text-white);
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition-smooth);
  align-self: flex-start;
}

.login-btn:hover:not(:disabled) {
  background: var(--btn-primary-hover);
  transform: translateY(-1px);
  box-shadow: var(--shadow-glow);
}

.login-btn.loading {
  opacity: 0.7;
  cursor: not-allowed;
}

.login-error {
  background: rgba(220, 38, 38, 0.15);
  border: 1px solid rgba(220, 38, 38, 0.3);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  font-size: 13px;
  color: #fca5a5;
  margin-bottom: 4px;
}


/* Ajustes para móviles (Pantallas menores a 768px) */
@media (max-width: 768px) {

  .login-main,
  .welcome-main,
  .q-main {
    flex-direction: column;
    padding: 20px;
    text-align: center;
  }

  .login-hero,
  .welcome-content {
    margin-bottom: 2rem;
  }

  .login-title,
  .welcome-title {
    font-size: 2rem;
    /* Títulos más pequeños en móvil */
  }

  .login-card,
  .q-content {
    width: 100%;
    max-width: 100%;
  }

  .q-nav {
    flex-direction: column-reverse;
    gap: 10px;
  }

  .q-btn {
    width: 100%;
    /* Botones de ancho completo */
  }
}

/* ── Registro ── */
.register-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.login-select {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.88);
  cursor: pointer;
}

.login-select option {
  background: #0b1733;
  color: #fff;
}

.register-actions {
  display: flex;
  gap: 10px;
}

.login-btn-secondary {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.6);
}

.login-btn-secondary:hover {
  background: rgba(255, 255, 255, 0.11);
  color: #fff;
}

.register-toggle-btn {
  width: 100%;
  margin-top: 12px;
  padding: 11px;
  background: rgba(201, 168, 76, 0.07);
  border: 1px dashed rgba(201, 168, 76, 0.3);
  border-radius: 10px;
  color: rgba(201, 168, 76, 0.8);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.2s;
}

.register-toggle-btn:hover {
  background: rgba(201, 168, 76, 0.12);
  border-color: rgba(201, 168, 76, 0.55);
  color: rgba(201, 168, 76, 1);
}

.card-mode-header {
  margin-bottom: 4px;
}
</file>

