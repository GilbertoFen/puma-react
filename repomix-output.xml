  margin-top: 4px;
}

/* Progress bar */
.q-progress-wrap {
  position: relative;
  z-index: 2;
  height: 3px;
  background: rgba(255, 255, 255, 0.08);
  margin: 0 80px;
  border-radius: 100px;
  overflow: hidden;
}

.q-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-blue-light), var(--border-gold));
  border-radius: 100px;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Main question area */
.q-main {
  flex: 1;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 40px 32px;
  gap: 40px;
  overflow: hidden;
}

/* Animated content wrapper */
.q-content {
  width: 100%;
  max-width: 760px;
}

.q-content.out-left {
  animation: slideOutLeft 0.32s cubic-bezier(0.4, 0, 1, 1) forwards;
}

.q-content.out-right {
  animation: slideOutRight 0.32s cubic-bezier(0.4, 0, 1, 1) forwards;
}

.q-content.in-right {
  animation: slideInRight 0.38s cubic-bezier(0, 0, 0.2, 1) both;
}

.q-content.in-left {
  animation: slideInLeft 0.38s cubic-bezier(0, 0, 0.2, 1) both;
}

.q-content.idle {
