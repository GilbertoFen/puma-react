  border-radius: 14px;
  overflow: hidden;
}

.tableHead {
  display: grid;
  grid-template-columns: 1fr 90px 44px;
  gap: 0;
  padding: 10px 18px;
  background: rgba(255,255,255,0.05);
  border-bottom: 1px solid rgba(255,255,255,0.07);
