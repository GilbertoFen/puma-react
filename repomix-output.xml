.root {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: var(--font-body, 'DM Sans', sans-serif);
}

/* ── Fondo idéntico al resto del proyecto ── */
.bgMesh {
  position: fixed;
  inset: 0;
  z-index: 0;
  background:
    radial-gradient(ellipse 80% 60% at 20% 30%, rgba(26, 79, 168, 0.35) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 70%, rgba(11, 23, 51, 0.8) 0%, transparent 60%),
    linear-gradient(160deg, #0b1733 0%, #060d1f 50%, #0a1628 100%);
}

.bgMesh::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 25% 25%, rgba(255,255,255,0.02) 1px, transparent 1px),
    radial-gradient(circle at 75% 75%, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 60px 60px, 40px 40px;
}

.goldLine {
  position: relative;
  z-index: 2;
  height: 2px;
  background: linear-gradient(90deg, rgba(201,168,76,0.8), rgba(201,168,76,0.2));
  flex-shrink: 0;
}

/* ── Main ── */
.main {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 24px;
}

/* ══════════════════════════════════════════
   ESTADO: upload
══════════════════════════════════════════ */
.uploadSection {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28px;
  width: 100%;
  max-width: 520px;
  animation: fadeUp 0.4s ease both;
}

.uploadHeader {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.title {
  font-family: var(--font-display, 'Sora', sans-serif);
  font-size: clamp(22px, 3.5vw, 32px);
  font-weight: 700;
  color: #fff;
}

.subtitle {
  font-size: 15px;
  color: rgba(255,255,255,0.55);
  line-height: 1.6;
  max-width: 440px;
}

/* Zona drop */
.dropZone {
  width: 100%;
  min-height: 200px;
  border: 2px dashed rgba(201,168,76,0.35);
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: border-color 0.25s, background 0.25s;
  padding: 32px 24px;
  background: rgba(255,255,255,0.03);
}

.dropZone:hover {
  border-color: rgba(201,168,76,0.6);
  background: rgba(255,255,255,0.05);
}

.dropZoneActive {
  border-color: rgba(201,168,76,0.8);
  background: rgba(201,168,76,0.05);
  box-shadow: 0 0 0 4px rgba(201,168,76,0.1);
}

.dropZoneReady {
  border-color: rgba(74,222,128,0.5);
  background: rgba(74,222,128,0.04);
  cursor: default;
}

/* Contenido vacío */
.dropContent {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: rgba(201,168,76,0.6);
  pointer-events: none;
}

.dropTitle {
  font-size: 16px;
  font-weight: 600;
  color: rgba(255,255,255,0.75);
}

.dropHint {
  font-size: 13px;
  color: rgba(255,255,255,0.35);
}

/* Archivo seleccionado */
.fileReady {
  display: flex;
  align-items: center;
  gap: 16px;
  width: 100%;
}

.fileInfo {
  flex: 1;
